{
	"name": "time-progress",
	"private": true,
	"version": "0.0.1",
	"packageManager": "bun@1.4.2",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "biome format --write .",
		"lint": "biome check .",
		"security:audit": "bun audit",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"test": "bun run test:unit",
		"verify": "bun run lint && bun run check && bun run test && bun run build && bun run security:audit",
		"deploy:workers": "bun run build && wrangler deploy",
		"deploy:pages": "bun run build && wrangler pages deploy .svelte-kit/output/client --functions .svelte-kit/output/server"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/luxon": "^3.7.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.2",
		"vite": "^8.3.0",
		"vitest": "^4.1.11",
		"wrangler": "^4.132.0"
	},
	"dependencies": {
		"luxon": "^3.5.0",
		"valibot": "^1.5.0"
	},
	"overrides": {
		"cookie": "0.7.2"
	}
}
